{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#ffffff" },
      "foreground": { "$value": "#5c5154" },
      "border": { "$value": "#b5b0b1" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#5c5154" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#5c5154" },
      "primary": {
        "$value": "#92946e",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#9d202f" },
      "secondaryForeground": { "$value": "#ffffff" },
      "muted": { "$value": "#b5b0b1" },
      "mutedForeground": { "$value": "#5c5154" },
      "accent": { "$value": "#f6c367" },
      "accentForeground": { "$value": "#5c5154" },
      "destructive": { "$value": "#9d202f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#b5b0b1" },
      "ring": { "$value": "#92946e" },
      "chart1": { "$value": "#92946e" },
      "chart2": { "$value": "#9d202f" },
      "chart3": { "$value": "#f6c367" },
      "chart4": { "$value": "#cb7a51" },
      "chart5": { "$value": "#c9ad6b" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#5c5154" },
      "sidebarBorder": { "$value": "#b5b0b1" },
      "sidebarPrimary": { "$value": "#92946e" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#cbcfbb" },
      "sidebarAccentForeground": { "$value": "#5c5154" },
      "sidebarRing": { "$value": "#92946e" }
    },
    "dark": {
      "background": { "$value": "#5c5154" },
      "foreground": { "$value": "#cbcfbb" },
      "border": { "$value": "#767661" },
      "card": { "$value": "#767661" },
      "cardForeground": { "$value": "#ffffff" },
      "popover": { "$value": "#5c5154" },
      "popoverForeground": { "$value": "#cbcfbb" },
      "primary": { "$value": "#92946e" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#af6e77" },
      "secondaryForeground": { "$value": "#5c5154" },
      "muted": { "$value": "#767661" },
      "mutedForeground": { "$value": "#cbcfbb" },
      "accent": { "$value": "#c9ad6b" },
      "accentForeground": { "$value": "#5c5154" },
      "destructive": { "$value": "#9d202f" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#767661" },
      "ring": { "$value": "#f6c367" },
      "chart1": { "$value": "#92946e" },
      "chart2": { "$value": "#af6e77" },
      "chart3": { "$value": "#f6c367" },
      "chart4": { "$value": "#cb7a51" },
      "chart5": { "$value": "#d799a1" },
      "sidebar": { "$value": "#5c5154" },
      "sidebarForeground": { "$value": "#cbcfbb" },
      "sidebarBorder": { "$value": "#767661" },
      "sidebarPrimary": { "$value": "#f6c367" },
      "sidebarPrimaryForeground": { "$value": "#5c5154" },
      "sidebarAccent": { "$value": "#767661" },
      "sidebarAccentForeground": { "$value": "#cbcfbb" },
      "sidebarRing": { "$value": "#f6c367" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Nunito", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
